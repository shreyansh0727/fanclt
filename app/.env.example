# Copy to .env (Expo loads it automatically) and adjust for your machine.
# Only EXPO_PUBLIC_* vars reach the app; they are inlined at bundle time,
# so never put secrets here.

# Backend on your PC, reachable from the phone over WiFi.
EXPO_PUBLIC_API_BASE=http://192.168.1.10:8000

# Local Firebase Auth emulator, e.g. http://192.168.1.10:9099
# Leave blank to sign in against the real Firebase project instead.
EXPO_PUBLIC_AUTH_EMULATOR=

# Local Realtime Database emulator, e.g. http://192.168.1.10:9000.
# Still set EXPO_PUBLIC_FIREBASE_DATABASE_URL below: the SDK takes the
# namespace from it and only swaps host/port for the emulator.
EXPO_PUBLIC_RTDB_EMULATOR=

# Real project values from Firebase console > Project settings > Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL, e.g. https://hrllo-530fe-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
